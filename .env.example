# ==========================================
# Database Configuration (Neon PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================
# Cloudinary Configuration (Media & Receipts)
# Uses unsigned upload preset — NO API Key/Secret needed!
# ==========================================
CLOUDINARY_CLOUD_NAME=dddsn39gd
CLOUDINARY_UPLOAD_PRESET=
# Optional if you ever want SDK admin signing:
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# Better Auth Configuration (Admin Security)
# ==========================================
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_random_32_character_secret_here

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Web Push Notification Configuration (VAPID)
# Generate with: npx web-push generate-vapid-keys
# ==========================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=